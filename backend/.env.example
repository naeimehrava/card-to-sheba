ZARINHUB_USERNAME=your-api-username
ZARINHUB_PASSWORD=your-api-password
ZARINHUB_ACCESS_TOKEN=
ZARINHUB_BASE_URL=https://zarin-hub.com/api
ZARINHUB_TIMEOUT=15s
ZARINHUB_TOKEN_SKEW=60s
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
TRUST_PROXY_HEADERS=false
DB_DRIVER=sqlite
DB_DSN=file:data/card-to-sheba.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)
AUDIT_CARD_HASH_SECRET=
LOG_LEVEL=info
LOG_FORMAT=json
